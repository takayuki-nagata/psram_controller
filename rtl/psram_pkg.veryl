// Package for Tang Nano 9K PSRAM Controller
// Clean-room implementation based on Winbond W955D8MBYA datasheet and Gowin IPUG943
pub package psram_pkg {
    // Timing requirements in ns (W955D8MBYA datasheet, sec. 11 and Table 14), with the
    // margins used; psram_core converts them to cycles of its CLK_HZ, rounding up.
    const T_RP_NS : u64 = 400; // RESET# pulse width: tRP >= 200 ns (x2)
    const T_VCS_NS: u64 = 200_000; // RESET# High to first access: tVCS >= 150 us (+33 %)
    const T_RWR_NS: u64 = 36; // CS# High between transactions: tRWR >= 36 ns (and tCSHI >= 6 ns)

    // Fixed latency mode: 2 * Initial Latency (Initial Latency = 6 PSRAM clock cycles)
    // Total 12 PSRAM clock cycles = 24 system clock cycles
    const FIXED_LATENCY_PSRAM_CLKS: u32 = 12;

    // CA phase: 3 PSRAM clock cycles (6 DDR transfers) = 6 system clock cycles
    const CA_PSRAM_CLKS: u32 = 3;

    // Command-Address Bit fields
    const CA_BIT_READ : logic = 1'b1;
    const CA_BIT_WRITE: logic = 1'b0;

    const CA_SPACE_MEM: logic = 1'b0;
    const CA_SPACE_REG: logic = 1'b1;

    const CA_BURST_WRAPPED: logic = 1'b0;
    const CA_BURST_LINEAR : logic = 1'b1;

    // HyperRAM Register Addresses
    const REG_ID0: logic<16> = 16'h0000;
    const REG_ID1: logic<16> = 16'h0001;
    const REG_CR0: logic<16> = 16'h0100;
    const REG_CR1: logic<16> = 16'h0101;
}
